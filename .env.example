# Public site configuration
NEXT_PUBLIC_SITE_URL=https://achintpalsingh.github.io
NEXT_PUBLIC_GITHUB_URL=https://github.com/achintarora-ai
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/achint-pal-singh-1a0114288/

# Server-only secrets — never expose these to the browser
# LLM_PROVIDER: auto | openai | anthropic | openrouter
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3.5-haiku

# Optional web search for the portfolio assistant
TAVILY_API_KEY=
USE_TAVILY=true

# Optional additional research tools (not required for core chat)
# GOVINFO_API_KEY=
# SERPAPI_API_KEY=
# USE_SERPAPI=false
# EXA_API_KEY=
# USE_EXA=false
